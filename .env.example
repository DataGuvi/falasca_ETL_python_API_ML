# Mercado Livre OAuth app credentials + a valid refresh token (bootstrap only
# -- after the first run, the rotated refresh_token is persisted in Postgres
# and takes over as source of truth).
ML_USER_ID=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=

# Postgres connection details
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public

# Optional overrides (defaults shown)
ML_SITE_ID=MLB
ML_MULTIGET_BATCH_SIZE=20
ML_HTTP_TIMEOUT=30
ML_MAX_RETRIES=5

# Saída de negócio na planilha Google Sheets "EXTRAÇÃO DE ANÚNCIOS MLB"
# (aba MATRIZ). Autenticação via service account -- baixe o JSON da chave no
# GCP e compartilhe a planilha com o client_email dele (permissão Editor).
# GOOGLE_SERVICE_ACCOUNT_FILE ou GOOGLE_SHEETS_SPREADSHEET_ID vazio desativa
# a escrita. GOOGLE_SHEETS_SPREADSHEET_ID é o trecho da URL da planilha entre
# /d/ e /edit.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=MATRIZ

# Alerta por e-mail em falha de run (ver drivers/email_alert.py, que delega
# pra utils/log_mail_message.py -- SMTP da Email em Nuvem, smtp.emailemnuvem.com.br).
# EMAIL_SENDER/SENDER_PASSWORD é a conta que envia (senha de app); EMAIL_RECEIVER
# é quem recebe o alerta. Faltando qualquer uma, o envio falha e só loga o erro.
EMAIL_SENDER=
SENDER_PASSWORD=
EMAIL_RECEIVER=
